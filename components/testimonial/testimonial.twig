{%
  set classes = [
    'my-5',
    'position-relative'
  ]
%}
{%
  set top_classes = [
    'd-flex',
    'flex-column-reverse',
    'flex-md-row-reverse',
    'align-items-center',
    'gap-4',
    'mt-4'
  ]
%}
{%
  set content_classes = [
    'flex-grow-1',
    'position-relative',
    'ps-5',
    'border-start',
    'border-4',
    'border-light',
    'font-serif',
    'fs-4',
    'lh-base',
    'my-0',
    'my-md-4'
  ]
%}

<div{{attributes.addClass(classes)}}>
  <div class="{{ top_classes|join(' ') }}">
    {% if image.src %}
      <div>
        <img loading="lazy" src="{{ image.src }}" alt="{{ image.alt }}" width="{{ image.width }}" height="{{ image.height }}" 
             class="rounded-circle" style="max-width: 100px;">
      </div>
    {% endif %}
    <blockquote class="{{ content_classes|join(' ') }}" style="letter-spacing: -0.01em;">
      <span class="position-absolute top-0 start-0 text-primary display-1" style="line-height: 0.5;">"</span>
      {{ content }}
    </blockquote>
  </div>

  {% if name or role %}
    <cite class="d-block ps-5 mt-3 fst-normal" style="font-size: 0.875rem;">
      {%- if name -%}
        <span class="d-inline-block fw-semibold text-secondary">{{ name }}</span>
      {%- endif -%}
      {%- if role -%}
        <span class="fw-normal text-muted">
          <span class="mx-2 text-secondary">|</span>
          {{ role }}
        </span>
      {%- endif -%}
    </cite>
  {% endif %}

  {% if link_url %}
    <div class="ps-5 mt-3">
      <a href="{{ link_url }}" class="btn btn-link text-decoration-none d-inline-flex align-items-center gap-1 p-0 fs-6">
        {{ link_text|default('Learn more'|t) }}
        <svg width="16" height="16" fill="currentColor">
          <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8z"/>
        </svg>
      </a>
    </div>
  {% endif %}
</div>
